{$DOMAIN:localhost} {
    # Certificado SSL automático gestionado por Caddy

    # Proxy para API y subida de fotos (hasta 30MB)
    handle /api/* {
        reverse_proxy backend:4000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Proxy para el frontend PWA
    handle {
        reverse_proxy frontend:80
    }

    encode gzip zstd
}
