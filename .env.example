# ========================================================
# CONFIGURACIÓN GENERAL
# ========================================================
PORT=4000
HOST=0.0.0.0
DATABASE_PATH=./data/study.db
PIN_CODE=1234
DOMAIN=tu-dominio.com

# ========================================================
# PROVEEDOR DE INTELIGENCIA ARTIFICIAL
# Opciones disponibles: claude | gemini | ollama | mock
# ========================================================
# - 'claude': Anthropic API (alta calidad didáctica, claude-3-5-sonnet)
# - 'gemini': Google Gemini Flash (opción en la nube oficial 100% GRATIS con Free Tier)
# - 'ollama': Ollama local (100% GRATIS, sin internet ni tarjetas)
# - 'mock': Modo demostración sin coste ni servidor de IA
AI_PROVIDER=mock

# --------------------------------------------------------
# 1. Anthropic Claude (si AI_PROVIDER=claude)
# --------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --------------------------------------------------------
# 2. Google Gemini Flash (si AI_PROVIDER=gemini)
# ¡Gratis en Google AI Studio con 15 peticiones/min!
# Obtén tu clave gratis en: https://aistudio.google.com/
# --------------------------------------------------------
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# --------------------------------------------------------
# 3. Ollama Visión Local (si AI_PROVIDER=ollama)
# 100% Gratis en tu ordenador de casa
# --------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision
